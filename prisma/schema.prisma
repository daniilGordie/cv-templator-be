generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())

  email         String    @unique
  password      String

  personalInfo  PersonalInfo?  @relation(name: "PersonalInfoToUser")

  resume        Resume[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model PersonalInfo {
  id            String    @id @default(cuid())
  firstName     String
  secondName    String?
  phoneNumber   String?
  homeTown      String?
  dateOfBirth   DateTime

  user        User?     @relation(name: "PersonalInfoToUser", fields: [userId], references: [id], onDelete: NoAction)
  userId      String?   @unique
}

 model Resume {
  id         String     @id @default(cuid())

  name       String

  user       User       @relation(fields: [userId], references: [id])
  userId     String

  sections   Section[]  @relation(name: "ResumeToSections")
  template   Template   @relation(fields: [templateId], references: [id])
  templateId String

  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Section {
  id        String    @id @default(cuid())

  name      String

  resume    Resume    @relation(name: "ResumeToSections", fields: [resumeId], references: [id])
  resumeId  String
  entries   Entry[]   @relation(name: "SectionsToEntries")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Entry {
  id          String   @id @default(cuid())

  title       String
  description String
  startDate   DateTime?
  endDate     DateTime?

  section     Section  @relation(name: "SectionsToEntries", fields: [sectionId], references: [id])
  sectionId   String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Template {
  id        String     @id @default(cuid())

  name      String
  style     String

  resume    Resume[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}